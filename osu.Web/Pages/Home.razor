    [JSInvokable]
    public async Task PumpGameFrame(long frame, BrowserInputEvent[] inputs, int width, int height)
    {
        if (!gameFailed && gameHost is not null)
        {
            try
            {
                gameHost.Resize(width, height);
                foreach (var input in inputs)
                    gameHost.BrowserInput.Receive(input);

                var browserContext = System.Threading.SynchronizationContext.Current;
                bool accepted;
                try
                {
                    accepted = gameHost.PumpFrame();
                }
                finally
                {
                    // Otherwise the interop continuation is queued on the draw
                    // scheduler, but JS will not pump again until this call finishes.
                    System.Threading.SynchronizationContext.SetSynchronizationContext(browserContext);
                }

                if (!accepted)
                {
                    // External-loop hosts may need several browser turns to finish
                    // startup. Keep queued input edges and retry on the next frame.
                    gameStatus = "waiting for framework host startup";
                    return;
                }

                if (gameStatus == "waiting for framework host startup")
                    gameStatus = Original ? "Realm-free browser game running" : "Framework diagnostic running — not OsuGame";

                // Texture uploads must be drained every update, but serialising the
                // complete drawable vertex stream at display refresh rate exhausts
                // the mobile WebAssembly heap on object-heavy maps. WebGL keeps the
                // previous geometry between transfers. Frame state uses the byte-array fast
                // interop path, allowing the scene to update at display refresh rate.
                var uploads = gameHost.GetBrowserTextureUploads();
                if (module is not null)
                {
                    if (uploads.Length > 0)
                        // Keep the reference-type array as one JS argument; otherwise
                        // params object[] expands it into individual upload arguments.
                        await module.InvokeVoidAsync("applyTextureUploads", (object)uploads);

                    // Decide before creating the packed frame array. On mobile, allocating
                    // a large byte[] only to skip its transfer still fragments the WASM heap.
                    int visualTransferDivisor = lastFrameFloatCount > 253333 ? 3
                                                : lastFrameFloatCount > 126666 ? 2
                                                : 1;
                    if (frame % visualTransferDivisor == 0)
                    {
                        byte[] state = gameHost.GetBrowserFrameState();
                        lastFrameFloatCount = Math.Max(0, (int)BitConverter.ToSingle(state, 4 * sizeof(float)));
                        await module.InvokeVoidAsync("applyFrameworkFrame", state);
                    }
                }
                gameFrameCount++;
                if (frame % 15 == 0 && songPreview is { } playingTrack)
                {
                    if (playingTrack.LoadError is { Length: > 0 } audioError)
                    {
                        await ReportHostFailure("The song audio could not be played: " + audioError);
                        return;
                    }
                    bool needsGesture = playingTrack.RequiresGesture;
                    if (audioNeedsGesture != needsGesture)
                    {
                        audioNeedsGesture = needsGesture;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                consecutiveFrameFailures = 0;

                if (gameplayResult is null && game?.GameplaySession is { IsReady: true } completed
                    && completed.ScoreProcessor.HasCompleted.Value)
                {
                    var score = completed.ScoreProcessor;
                    gameplayResult = new PlayResult(selectedDifficulty?.DifficultyName ?? "",
                        score.TotalScore.Value, score.Accuracy.Value, score.HighestCombo.Value);
                    completed.GameplayState.HasPassed = true;
                    game.PauseGameplay();
                    gameplayPaused = true;
                    if (module is not null) await module.InvokeVoidAsync("setGameplayActive", false);
                    if (module is not null) await module.InvokeVoidAsync("exitFullscreen");
                    selectionStatus = "Play complete.";
                    await SaveCompletedScore(gameplayResult);
                    await InvokeAsync(StateHasChanged);
                }

                if (!string.IsNullOrEmpty(game?.GameplayError)
                    && !selectionStatus.StartsWith("Gameplay failed:", StringComparison.Ordinal))
                {
                    selectionStatus = "Gameplay failed: " + game.GameplayError;
                }
                else if (game?.GameplaySession is { IsReady: true } session
                         && selectionStatus.StartsWith("Starting ", StringComparison.Ordinal))
                {
                    selectionStatus = $"Playing {selectedDifficulty?.DifficultyName}: {selectedBeatmap?.HitObjects.Count ?? 0} objects · {session.Clock.CurrentTime:0} ms";
                }
            }
            catch (OutOfMemoryException exception)
            {
                consecutiveFrameFailures++;
                if (consecutiveFrameFailures == 1) GC.Collect();
                gameFailed = consecutiveFrameFailures >= 3;
                songPreview?.Stop();
                gameStatus = "Browser memory exhausted. Reload the player or try a smaller beatmap. " + exception.Message;
            }
            catch (Exception exception)
            {
                // Retry transient rendering and interop failures on the next frame.
                consecutiveFrameFailures++;
                gameFailed = consecutiveFrameFailures >= 3;
                if (gameFailed) songPreview?.Stop();
                gameStatus = $"Frame recovery attempt {consecutiveFrameFailures}: {FormatException(exception)}";
            }
        }

        // Re-rendering the full Blazor page during gameplay causes periodic
        // main-thread stalls on phones and tablets.
        if (frame % 180 == 0 || gameFailed || consecutiveFrameFailures > 0)
            await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ReportInput(string kind, double x, double y)
    {
        inputStatus = $"{selectedMode}: {kind} · {x:0}, {y:0}";
        // Batch diagnostic UI updates outside the latency-sensitive input path.
        return Task.CompletedTask;
    }

    private static string FormatException(Exception exception)
    {
        Console.Error.WriteLine(exception);
        var messages = new List<string>();

        for (Exception? current = exception; current is not null; current = current.InnerException)
            messages.Add($"{current.GetType().Name}: {current.Message}");

        return string.Join(" → ", messages);
    }

    public async ValueTask DisposeAsync()
    {
        await StopSongPreviewAsync();
        beatmapLoader?.Dispose();
        foreach (var config in rulesetConfigs) config.Dispose();
        if (settingsStore is not null)
        {
            try { await settingsStore.FlushAsync(); }
            catch (Exception exception) { Console.Error.WriteLine("Settings commit failed during shutdown: " + exception); }
        }
        if (fileStore is not null)
            await fileStore.DisposeAsync();

        if (module is not null)
        {
            await module.InvokeVoidAsync("stopBrowserHost");
            await module.DisposeAsync();
        }

        gameHost?.Dispose();
        gameHost = null;
        game = null;
        self?.Dispose();
        osu.Framework.Audio.Track.BrowserTrackProvider.CreateTrack = null;
        osu.Framework.Audio.Sample.BrowserSampleFactory.CreateFactory = null;
        if (samplesModule is not null)
        {
            samplesModule.InvokeVoid("disposeSamples");
            await samplesModule.DisposeAsync();
        }
        if (audioModule is not null)
        {
            audioModule.InvokeVoid("disposeAudio");
            await audioModule.DisposeAsync();
        }
    }
