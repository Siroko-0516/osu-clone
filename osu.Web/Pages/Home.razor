@page "/"
@using osu.Game
@using osu.Game.Rulesets.Osu
@using osu.Game.Rulesets.Mania
@using osu.Game.Rulesets.Taiko
@using osu.Game.Rulesets.Catch
@using osu.Framework.Platform
@using osu.Game.Rulesets.Osu.Configuration
@using osu.Web.Storage
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject osu.Game.Database.Persistence.IRecordStore Records

<PageTitle>osu! web port laboratory</PageTitle>

<main class="port-shell">
    <header>
        <div class="ring" aria-hidden="true"><span>web</span></div>
        <div>
            <p class="phase">BROWSER PORT · RENDERER PHASE</p>
            <h1>@(Original ? "osu! browser gameplay runtime." : "Framework renderer diagnostics.")</h1>
            <p class="lede">@(Original ? "Realm-free browser services now load original ruleset playfields, controls and local songs." : "This view isolates the renderer and input bridge for diagnostics.")</p>
            <button @onclick="SwitchRuntime">@(Original ? "Open framework diagnostics" : "Open browser gameplay runtime")</button>
        </div>
    </header>

    <nav class="mode-picker" aria-label="Ruleset">
        <button class="@(selectedMode == "osu" ? "active" : null)" @onclick='() => SelectMode("osu")'>osu!standard</button>
        <button class="@(selectedMode == "mania" ? "active" : null)" @onclick='() => SelectMode("mania")'>osu!mania</button>
        <button class="@(selectedMode == "taiko" ? "active" : null)" @onclick='() => SelectMode("taiko")'>osu!taiko</button>
        <button class="@(selectedMode == "catch" ? "active" : null)" @onclick='() => SelectMode("catch")'>osu!catch</button>
    </nav>

    @if (selectedMode == "mania")
    {
        <nav class="key-picker" aria-label="osu!mania key count">
            @for (int keys = 1; keys <= 9; keys++)
            {
                int keyCount = keys;
                <button class="@(maniaKeys == keyCount ? "active" : null)" @onclick="() => SelectManiaKeys(keyCount)">@keyCount K</button>
            }
        </nav>
    }

    @if (bindingRows.Count > 0)
    {
        <section class="binding-editor" aria-label="Current ruleset key bindings">
            <div class="binding-title"><strong>@BindingEditorTitle key bindings</strong><button @onclick="ResetCurrentBindings">Restore defaults</button></div>
            @foreach (var row in bindingRows)
            {
                <label @key="row"><span>@row.ActionName</span><select value="@((int)row.Key)" @onchange="args => ChangeBinding(row, args)" disabled="@bindingsSaving">
                    @foreach (var key in selectableKeys)
                    {
                        <option value="@((int)key)">@key</option>
                    }
                </select></label>
            }
        </section>
    }

    <section class="canvas-panel">
        <canvas @ref="canvas" tabindex="0" aria-label="osu browser game canvas"></canvas>
        <div class="canvas-hint">@ModeInputHint</div>
    </section>

    <div>
        <label class="file-import">Import beatmap (.osz) <InputFile OnChange="ImportBeatmap" accept=".osz,application/zip" disabled="@importingBeatmap" /></label>
        <span>@beatmapImportStatus</span>
        @if (selectedBeatmap is not null)
        {
            <button @onclick="() => game?.PauseGameplay()">Pause gameplay</button>
            <button @onclick="() => game?.ResumeGameplay()">Resume gameplay</button>
            <button @onclick="() => game?.RestartGameplay()">Restart gameplay</button>
        }
        <button @onclick="StartAudioTest">Play 5-second framework audio test</button>
        <button @onclick="() => game?.AudioTestTrack?.Stop()">Pause audio test</button>
        <button @onclick="() => game?.AudioTestTrack?.Seek(2000)">Seek audio test to 2 seconds</button>
        <button @onclick="StartSampleTest">Play 200-ms framework sample</button>
        <button @onclick="() => SetActionKeys(true)">Use A / X for action test</button>
        <button @onclick="() => SetActionKeys(false)">Restore Z / X action defaults</button>
    </div>

    <section class="song-library" aria-label="Imported songs">
        <h2>Your songs</h2>
        <label>Search songs <input @bind="songSearch" @bind:event="oninput" placeholder="Title, artist or mapper" /></label>
        @if (beatmapCatalog is null || beatmapLoader is null)
        {
            <p>Loading your library…</p>
        }
        else if (beatmapCatalog.Sets.Count == 0)
        {
            <p>Import an .osz file to add your first song. Songs stay in this browser.</p>
        }
        else
        {
            @foreach (var set in VisibleSets)
            {
                <article @key="set.Id">
                    <h3>@set.Artist — @set.Title</h3>
                    <p>Mapped by @set.Creator</p>
                    <div class="difficulty-list">
                        @foreach (var difficulty in beatmapCatalog.GetBeatmaps(set.Id))
                        {
                            <button @key="difficulty.Id" class="@(selectedDifficulty?.Id == difficulty.Id ? "active" : null)"
                                    aria-pressed="@(selectedDifficulty?.Id == difficulty.Id)" disabled="@importingBeatmap"
                                    @onclick="() => SelectDifficulty(difficulty)">
                                @difficulty.DifficultyName · @RulesetLabel(difficulty.RulesetId)
                            </button>
                        }
                    </div>
                </article>
            }
            @if (!VisibleSets.Any())
            {
                <p>No matching songs.</p>
            }
        }
        <p role="status">@selectionStatus</p>
        @if (songPreview is not null && songPreview.LoadError.Length > 0)
        {
            <p role="alert">Could not preview audio: @songPreview.LoadError</p>
        }
        @if (selectedBeatmap is not null)
        {
            <div class="song-preview">
                <button @onclick="PreviewSong">Preview music</button>
                <button @onclick="StopSongPreview">Stop preview</button>
                <span>@selectedBeatmap.HitObjects.Count objects · CS @selectedBeatmap.Difficulty.CircleSize · OD @selectedBeatmap.Difficulty.OverallDifficulty</span>
            </div>
        }
    </section>

    <dl>
        <div><dt>Original ruleset settings test</dt><dd>
            <label><input type="checkbox" disabled="@(osuConfig is null || settingsSaving)" checked="@(osuConfig?.Get<bool>(OsuRulesetSetting.SnakingInSliders) ?? true)" @onchange="SetSnaking" /> Snaking-in sliders</label>
            <span>@settingsStatus</span>
        </dd></div>
        <div><dt>Original game</dt><dd>@(Original ? "Startup requested — see runtime status; gameplay unverified" : "Not started — native services still require porting")</dd></div>
        <div><dt>Diagnostic runtime</dt><dd>@gameStatus</dd></div>
        <div><dt>GPU renderer</dt><dd>@rendererStatus</dd></div>
        <div><dt>Diagnostic frames</dt><dd>@gameFrameCount</dd></div>
        <div><dt>Input bridge</dt><dd>@inputStatus</dd></div>
        <div><dt>Framework input events</dt><dd>@(game?.ProcessedInputEvents ?? 0)</dd></div>
        <div><dt>Original ruleset action test</dt><dd>@(game?.LastAction ?? "none") · @(game?.ActionPressCount ?? 0) pressed / @(game?.ActionReleaseCount ?? 0) released · @keyBindingStatus</dd></div>
        <div><dt>Browser file storage</dt><dd>@fileStatus</dd></div>
        <div><dt>Browser beatmap catalogue</dt><dd>@beatmapCatalogStatus</dd></div>
        <div><dt>Framework audio position</dt><dd>@(game?.AudioTestTrack?.CurrentTime.ToString("0") ?? "0") ms</dd></div>
        <div><dt>Framework sample</dt><dd>@(game?.AudioTestSample?.Length.ToString("0") ?? "0") ms · @(game?.SamplePlayCount ?? 0) plays</dd></div>
        <div><dt>standard</dt><dd>@typeof(OsuRuleset).Assembly.GetName().Name</dd></div>
        <div><dt>mania</dt><dd>@typeof(ManiaRuleset).Assembly.GetName().Name</dd></div>
        <div><dt>taiko</dt><dd>@typeof(TaikoRuleset).Assembly.GetName().Name</dd></div>
        <div><dt>catch</dt><dd>@typeof(CatchRuleset).Assembly.GetName().Name</dd></div>
    </dl>
</main>

@code {
    [SupplyParameterFromQuery]
    public bool Original { get; set; }

    private void SwitchRuntime() => Navigation.NavigateTo($"?original={!Original}", forceLoad: true);

    private ElementReference canvas;
    private IJSObjectReference? module;
    private IJSInProcessObjectReference? audioModule;
    private IJSInProcessObjectReference? samplesModule;
    private DotNetObjectReference<Home>? self;
    private WebGameHost? gameHost;
    private BrowserBootstrapGame? game;
    private long gameFrameCount;
    private string rendererStatus = "initialising";
    private string gameStatus = "waiting";
    private string inputStatus = "waiting";
    private string selectedMode = "osu";
    private int maniaKeys = 4;
    private string ModeInputHint => selectedMode switch
    {
        "osu" => "osu!standard · aim with the pointer · hit/hold with mouse or Z / X",
        "mania" => $"osu!mania {maniaKeys}K · play all {maniaKeys} note lanes with keyboard keys",
        "taiko" => "osu!taiko · hit rim/centre with D / F / J / K",
        "catch" => "osu!catch · move with Z / X or ← / → · dash with Shift",
        _ => "Keyboard input"
    };
    private bool gameFailed;
    private BrowserSettingsStore? settingsStore;
    private BrowserKeyBindingStore? keyBindingStore;
    private string keyBindingStatus = "Loading";
    private OsuRulesetConfigManager? osuConfig;
    private readonly List<IDisposable> rulesetConfigs = new();
    private bool settingsSaving;
    private string settingsStatus = "Loading browser settings";
    private BrowserFileStore? fileStore;
    private osu.Framework.Platform.Storage? persistentStorage;
    private string fileStatus = "Loading browser files";
    private osu.Game.Database.Persistence.IGamePersistence? persistence;
    private osu.Game.Database.Persistence.BeatmapCatalogStore? beatmapCatalog;
    private string beatmapCatalogStatus = "Loading browser beatmap metadata";
    private string beatmapImportStatus = "No beatmap imported";
    private bool importingBeatmap;
    private BrowserBeatmapLoader? beatmapLoader;
    private osu.Game.Database.Persistence.BeatmapSnapshot? selectedDifficulty;
    private osu.Game.Beatmaps.IBeatmap? selectedBeatmap;
    private WebAudioTrack? songPreview;
    private string songSearch = "";
    private string selectionStatus = "Select a difficulty to load it. Gameplay rendering is still being ported.";
    private IEnumerable<osu.Game.Database.Persistence.BeatmapSetSnapshot> VisibleSets =>
        (beatmapCatalog?.Sets ?? Array.Empty<osu.Game.Database.Persistence.BeatmapSetSnapshot>())
        .Where(set => string.IsNullOrWhiteSpace(songSearch) || $"{set.Artist} {set.Title} {set.Creator}".Contains(songSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string RulesetLabel(int mode) => mode switch
    {
        0 => "osu!standard", 1 => "osu!taiko", 2 => "osu!catch", 3 => "osu!mania", _ => "Unknown mode"
    };

    private async Task SelectDifficulty(osu.Game.Database.Persistence.BeatmapSnapshot difficulty)
    {
        StopSongPreview();
        selectedDifficulty = null;
        selectedBeatmap = null;
        try
        {
            if (beatmapLoader is null || persistentStorage is null || audioModule is null) return;
            var loaded = beatmapLoader.Load(difficulty.Id);
            string mode = difficulty.RulesetId switch { 0 => "osu", 1 => "taiko", 2 => "catch", 3 => "mania", _ => throw new InvalidDataException("Unsupported mode.") };
            if (mode == "mania") maniaKeys = (int)loaded.Difficulty.CircleSize;
            await SelectMode(mode);
            audioModule.InvokeVoid("unlockAudio");
            songPreview = new WebAudioTrack(audioModule, persistentStorage.GetStream(difficulty.AudioPath), difficulty.AudioPath);
            game?.LoadBeatmap(loaded, CurrentRuleset, songPreview);
            selectedDifficulty = difficulty;
            selectedBeatmap = loaded;
            selectionStatus = $"Loaded {difficulty.DifficultyName}: {loaded.HitObjects.Count} objects using the original {RulesetLabel(difficulty.RulesetId)} playfield.";
        }
        catch (Exception exception) { selectionStatus = "Could not load difficulty: " + exception.Message; }
    }

    private void PreviewSong()
    {
        if (selectedDifficulty is null || selectedBeatmap is null || persistentStorage is null || audioModule is null) return;
        try
        {
            game?.AudioTestTrack?.Stop();
            audioModule.InvokeVoid("unlockAudio");
            double previewTime = Math.Max(0, selectedBeatmap.Metadata.PreviewTime);
            if (game?.GameplayClock is not null)
            {
                game.GameplayClock.Seek(previewTime);
                game.GameplayClock.Start();
            }
            else
            {
                songPreview.Seek(previewTime);
                songPreview.Start();
            }
        }
        catch (Exception exception) { StopSongPreview(); selectionStatus = "Preview failed: " + exception.Message; }
    }

    private void StopSongPreview()
    {
        if (songPreview is null)
            return;

        if (game?.GameplaySession?.Track == songPreview)
        {
            // The gameplay session owns this track and disposes it on the update thread.
            game.StopGameplay();
        }
        else
        {
            songPreview.Stop();
            songPreview.Dispose();
            songPreview.Update();
        }

        songPreview = null;
    }

    private bool bindingsSaving;
    private List<BindingEditorRow> bindingRows = new();
    private static readonly osu.Framework.Input.Bindings.InputKey[] selectableKeys = Enum.GetValues<osu.Framework.Input.Bindings.InputKey>()
        .Where(key => ((int)key >= 1 && (int)key <= 130) || ((int)key >= 132 && (int)key <= 134))
        .DistinctBy(key => (int)key).ToArray();
    private int CurrentVariant => selectedMode == "mania" ? maniaKeys : 0;
    private osu.Game.Rulesets.Ruleset CurrentRuleset => selectedMode switch
    {
        "mania" => new ManiaRuleset(), "taiko" => new TaikoRuleset(), "catch" => new CatchRuleset(), _ => new OsuRuleset()
    };
    private string BindingEditorTitle => selectedMode switch
    {
        "osu" => "osu!standard", "mania" => $"osu!mania {maniaKeys}K", "taiko" => "osu!taiko", "catch" => "osu!catch", _ => selectedMode
    };

    private string GetActionName(int action) => selectedMode switch
    {
        "mania" => Enum.GetName(typeof(ManiaAction), action),
        "taiko" => Enum.GetName(typeof(TaikoAction), action),
        "catch" => Enum.GetName(typeof(CatchAction), action),
        _ => Enum.GetName(typeof(OsuAction), action)
    } ?? action.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private sealed class BindingEditorRow
    {
        public required int Action { get; init; }
        public required string ActionName { get; init; }
        public osu.Framework.Input.Bindings.InputKey Key { get; set; }
    }

    private void LoadBindingEditor()
    {
        if (keyBindingStore is null) return;
        var ruleset = CurrentRuleset;
        IReadOnlyList<osu.Framework.Input.Bindings.IKeyBinding> bindings = keyBindingStore.GetBindings(ruleset.RulesetInfo.ShortName, CurrentVariant);
        if (bindings.Count == 0) bindings = ruleset.GetDefaultKeyBindings(CurrentVariant).Cast<osu.Framework.Input.Bindings.IKeyBinding>().ToArray();
        bindingRows = bindings.Where(binding => binding.KeyCombination.Keys.Any(key => key != osu.Framework.Input.Bindings.InputKey.None))
            .Select(binding => new BindingEditorRow
            {
                Action = Convert.ToInt32(binding.Action),
                ActionName = GetActionName(Convert.ToInt32(binding.Action)),
                Key = binding.KeyCombination.Keys.First(key => key != osu.Framework.Input.Bindings.InputKey.None)
            }).ToList();
    }

    private async Task SaveBindingEditor()
    {
        if (keyBindingStore is null) return;
        bindingsSaving = true;
        try
        {
            var ruleset = CurrentRuleset;
            await keyBindingStore.SaveBindingsAsync(ruleset.RulesetInfo.ShortName, CurrentVariant,
                bindingRows.Select(row => (osu.Framework.Input.Bindings.IKeyBinding)new osu.Framework.Input.Bindings.KeyBinding(row.Key, row.Action)));
            keyBindingStatus = $"{BindingEditorTitle} bindings saved";
        }
        catch (Exception exception) { keyBindingStatus = "Save failed: " + exception.Message; }
        finally { bindingsSaving = false; }
    }

    private async Task ChangeBinding(BindingEditorRow row, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int value) && Enum.IsDefined(typeof(osu.Framework.Input.Bindings.InputKey), value))
        {
            var next = (osu.Framework.Input.Bindings.InputKey)value;
            if (bindingRows.Any(other => !ReferenceEquals(other, row) && other.Key == next))
            {
                keyBindingStatus = $"{next} is already assigned in {BindingEditorTitle}";
                LoadBindingEditor();
                await InvokeAsync(StateHasChanged);
                return;
            }
            row.Key = next;
            await SaveBindingEditor();
        }
    }

    private async Task ResetCurrentBindings()
    {
        if (keyBindingStore is null) return;
        var ruleset = CurrentRuleset;
        await keyBindingStore.SaveBindingsAsync(ruleset.RulesetInfo.ShortName, CurrentVariant, ruleset.GetDefaultKeyBindings(CurrentVariant));
        LoadBindingEditor();
        await SyncBrowserBindings();
        keyBindingStatus = $"{BindingEditorTitle} defaults restored";
    }

    private async Task SetActionKeys(bool useA)
    {
        if (keyBindingStore is null) return;
        try
        {
            var ruleset = new OsuRuleset();
            var bindings = ruleset.GetDefaultKeyBindings(0).Select(binding => (osu.Framework.Input.Bindings.IKeyBinding)new osu.Framework.Input.Bindings.KeyBinding(
                new osu.Framework.Input.Bindings.KeyCombination(binding.KeyCombination.Keys.Select(key => useA && key == osu.Framework.Input.Bindings.InputKey.Z ? osu.Framework.Input.Bindings.InputKey.A : key).ToArray()), binding.Action));
            await keyBindingStore.SaveBindingsAsync(ruleset.RulesetInfo.ShortName, 0, bindings);
            LoadBindingEditor();
            await SyncBrowserBindings();
            keyBindingStatus = useA ? "A / X saved" : "Z / X defaults saved";
        }
        catch (Exception exception) { keyBindingStatus = "Save failed: " + exception.Message; }
    }

    private async Task SetSnaking(ChangeEventArgs args)
    {
        if (osuConfig is null || settingsStore is null) return;
        settingsSaving = true;
        settingsStatus = "Saving";
        try
        {
            osuConfig.SetValue(OsuRulesetSetting.SnakingInSliders, args.Value is true);
            osuConfig.Save();
            await settingsStore.FlushAsync();
            settingsStatus = "Saved to browser";
        }
        catch (Exception exception) { settingsStatus = "Save failed: " + exception.Message; }
        finally { settingsSaving = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            settingsStore = await BrowserSettingsStore.CreateAsync(Records);
            keyBindingStore = await BrowserKeyBindingStore.CreateAsync(Records);
            persistence = await osu.Game.Database.Persistence.GamePersistence.CreateAsync(Records, settingsStore);
            beatmapCatalog = persistence.Beatmaps;
            beatmapCatalogStatus = $"{beatmapCatalog.Sets.Count} sets / {beatmapCatalog.Beatmaps.Count} difficulties restored";
            keyBindingStatus = "Browser key bindings loaded";
            LoadBindingEditor();
            foreach (var ruleset in new osu.Game.Rulesets.Ruleset[] { new OsuRuleset(), new ManiaRuleset(), new TaikoRuleset() })
            {
                var config = ruleset.CreateConfig(settingsStore);
                if (config is not null) rulesetConfigs.Add(config);
                if (config is OsuRulesetConfigManager standardConfig) osuConfig = standardConfig;
            }
            await settingsStore.FlushAsync();
            settingsStatus = "Original osu!, mania and taiko settings loaded";
            audioModule = (IJSInProcessObjectReference)await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserAudio.mjs");
            osu.Framework.Audio.Track.BrowserTrackProvider.CreateTrack = (stream, name) => new WebAudioTrack(audioModule, stream, name);
            samplesModule = (IJSInProcessObjectReference)await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserSamples.mjs");
            osu.Framework.Audio.Sample.BrowserSampleFactory.CreateFactory = (bytes, name, mixer) => new WebAudioSampleFactory(samplesModule, bytes, name, mixer);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserHost.js?v=3-input");
            self = DotNetObjectReference.Create(this);
            bool rendererReady = await module.InvokeAsync<bool>("startBrowserHost", canvas, self);
            if (!rendererReady)
            {
                gameFailed = true;
                gameStatus = "Stopped — WebGL2 unavailable";
                StateHasChanged();
                return;
            }

            gameStatus = "initialising BrowserGameHost";
            StateHasChanged();
            gameHost = new WebGameHost("osu-web");
            persistentStorage = gameHost.GetStorage("/osu-data");
            fileStore = new BrowserFileStore(JS);
            int restoredFiles = await fileStore.HydrateAsync(persistentStorage);
            fileStatus = $"{restoredFiles} browser files restored";
            beatmapLoader = new BrowserBeatmapLoader(beatmapCatalog, path => persistentStorage.GetStream(path, FileAccess.Read, FileMode.Open));
            osu.Framework.Game selectedGame;
            if (Original)
                selectedGame = game = new BrowserOsuGame(keyBindingStore, persistence);
            else
                selectedGame = game = new BrowserBootstrapGame(keyBindingStore, persistence);
            // Framework threads install their own SynchronizationContext. Blazor must
            // regain its context before awaiting JS interop or dispatching UI work.
            var browserContext = System.Threading.SynchronizationContext.Current;
            try
            {
                gameHost.Run(selectedGame);
            }
            finally
            {
                System.Threading.SynchronizationContext.SetSynchronizationContext(browserContext);
            }
            gameStatus = Original ? "Realm-free browser game running" : "Framework diagnostic running — not OsuGame";
        }
        catch (Exception exception)
        {
            gameFailed = true;
            gameStatus = FormatException(exception);
        }

        StateHasChanged();
    }

    private async Task SelectMode(string mode)
    {
        selectedMode = mode;
        game?.SetRuleset(mode, mode == "mania" ? maniaKeys : 0);
        LoadBindingEditor();
        keyBindingStatus = $"{BindingEditorTitle} bindings loaded";
        await SyncBrowserBindings();
    }

    private async Task SelectManiaKeys(int keys)
    {
        maniaKeys = Math.Clamp(keys, 1, 9);
        game?.SetRuleset("mania", maniaKeys);
        LoadBindingEditor();
        await SyncBrowserBindings();
        keyBindingStatus = $"mania {maniaKeys}K bindings loaded";
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncBrowserBindings()
    {
        if (module is null)
            return;

        string[] codes = bindingRows.Select(row => ToBrowserCode(row.Key))
                                    .Where(code => code is not null)
                                    .Cast<string>()
                                    .Distinct(StringComparer.Ordinal)
                                    .ToArray();
        await module.InvokeVoidAsync("setRuleset", selectedMode, (object)codes);
    }

    private static string? ToBrowserCode(osu.Framework.Input.Bindings.InputKey key)
    {
        string name = key.ToString();
        if (name.Length == 1 && name[0] is >= 'A' and <= 'Z')
            return "Key" + name;
        if (name.StartsWith("Number", StringComparison.Ordinal) && name.Length == 7)
            return "Digit" + name[6];
        if (name.StartsWith("Keypad", StringComparison.Ordinal))
            return "Numpad" + name[6..];

        return key switch
        {
            osu.Framework.Input.Bindings.InputKey.Left => "ArrowLeft",
            osu.Framework.Input.Bindings.InputKey.Right => "ArrowRight",
            osu.Framework.Input.Bindings.InputKey.Up => "ArrowUp",
            osu.Framework.Input.Bindings.InputKey.Down => "ArrowDown",
            osu.Framework.Input.Bindings.InputKey.Shift => "ShiftLeft",
            osu.Framework.Input.Bindings.InputKey.Control => "ControlLeft",
            osu.Framework.Input.Bindings.InputKey.Alt => "AltLeft",
            osu.Framework.Input.Bindings.InputKey.BackSpace => "Backspace",
            osu.Framework.Input.Bindings.InputKey.Tilde => "Backquote",
            osu.Framework.Input.Bindings.InputKey.Plus => "Equal",
            osu.Framework.Input.Bindings.InputKey.BackSlash => "Backslash",
            >= osu.Framework.Input.Bindings.InputKey.MouseLeft => null,
            _ => name,
        };
    }

    private async Task StartAudioTest()
    {
        StopSongPreview();
        audioModule?.InvokeVoid("unlockAudio");
        game?.StartAudioTest();
        await FlushFiles();
    }

    private async Task ImportBeatmap(InputFileChangeEventArgs args)
    {
        if (beatmapCatalog is null || persistentStorage is null || fileStore is null)
            return;

        importingBeatmap = true;
        beatmapImportStatus = $"Reading {args.File.Name}";
        try
        {
            await using Stream stream = args.File.OpenReadStream(maxAllowedSize: 256 * 1024 * 1024);
            // InputFile streams do not support synchronous reads or seeking, which ZipArchive needs.
            using var archiveBytes = new MemoryStream();
            await stream.CopyToAsync(archiveBytes);
            archiveBytes.Position = 0;
            var package = osu.Game.Database.Persistence.OszArchiveReader.Read(archiveBytes);
            StopSongPreview();
            selectedDifficulty = null;
            selectedBeatmap = null;
            selectionStatus = "Select a difficulty to load it.";
            foreach (var file in package.Files)
            {
                using Stream output = persistentStorage.GetStream(file.Path, FileAccess.Write, FileMode.Create);
                await output.WriteAsync(file.Data);
            }

            // Persist only the imported archive entries. Re-snapshotting every browser file
            // on each import multiplies peak memory use for large beatmap libraries.
            await fileStore.PutAsync(package.Files.Select(file => new BrowserFileStore.Entry
            {
                Path = file.Path,
                Data = file.Data,
            }));
            await beatmapCatalog.SaveSetAsync(package.Set, package.Beatmaps);
            beatmapCatalogStatus = $"{beatmapCatalog.Sets.Count} sets / {beatmapCatalog.Beatmaps.Count} difficulties restored";
            beatmapImportStatus = $"Imported {package.Set.Artist} — {package.Set.Title} ({package.Beatmaps.Count} difficulties)";
        }
        catch (Exception exception)
        {
            beatmapImportStatus = "Import failed: " + exception.Message;
        }
        finally
        {
            importingBeatmap = false;
        }
    }

    private async Task StartSampleTest()
    {
        audioModule?.InvokeVoid("unlockAudio");
        game?.StartSampleTest();
        await FlushFiles();
    }

    private async Task FlushFiles()
    {
        if (fileStore is null || persistentStorage is null) return;
        try { await fileStore.FlushAsync(persistentStorage); fileStatus = "Browser files saved"; }
        catch (Exception exception) { fileStatus = "File save failed: " + exception.Message; }
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ReportRenderer(string renderer)
    {
        rendererStatus = renderer;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task PumpGameFrame(long frame, BrowserInputEvent[] inputs, int width, int height)
    {
        if (!gameFailed && gameHost is not null)
        {
            try
            {
                gameHost.Resize(width, height);
                foreach (var input in inputs)
                    gameHost.BrowserInput.Receive(input);

                var browserContext = System.Threading.SynchronizationContext.Current;
                bool accepted;
                try
                {
                    accepted = gameHost.PumpFrame();
                }
                finally
                {
                    // Otherwise the interop continuation is queued on the draw
                    // scheduler, but JS will not pump again until this call finishes.
                    System.Threading.SynchronizationContext.SetSynchronizationContext(browserContext);
                }

                if (!accepted)
                {
                    // External-loop hosts may need several browser turns to finish
                    // startup. Keep queued input edges and retry on the next frame.
                    gameStatus = "waiting for framework host startup";
                    return;
                }

                if (gameStatus == "waiting for framework host startup")
                    gameStatus = Original ? "Realm-free browser game running" : "Framework diagnostic running — not OsuGame";

                var uploads = gameHost.GetBrowserTextureUploads();
                float[] state = gameHost.GetBrowserFrameState();
                if (module is not null)
                {
                    if (uploads.Length > 0)
                        // Keep the reference-type array as one JS argument; otherwise
                        // params object[] expands it into individual upload arguments.
                        await module.InvokeVoidAsync("applyTextureUploads", (object)uploads);

                    await module.InvokeVoidAsync("applyFrameworkFrame", state);
                }
                gameFrameCount++;
            }
            catch (Exception exception)
            {
                gameFailed = true;
                gameStatus = FormatException(exception);
            }
        }

        if (frame % 30 == 0 || gameFailed)
            await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ReportInput(string kind, double x, double y)
    {
        inputStatus = $"{selectedMode}: {kind} · {x:0}, {y:0}";
        return InvokeAsync(StateHasChanged);
    }

    private static string FormatException(Exception exception)
    {
        Console.Error.WriteLine(exception);
        var messages = new List<string>();

        for (Exception? current = exception; current is not null; current = current.InnerException)
            messages.Add($"{current.GetType().Name}: {current.Message}");

        return string.Join(" → ", messages);
    }

    public async ValueTask DisposeAsync()
    {
        StopSongPreview();
        beatmapLoader?.Dispose();
        foreach (var config in rulesetConfigs) config.Dispose();
        if (settingsStore is not null)
        {
            try { await settingsStore.FlushAsync(); }
            catch (Exception exception) { Console.Error.WriteLine("Settings commit failed during shutdown: " + exception); }
        }
        if (fileStore is not null)
        {
            if (persistentStorage is not null)
            {
                try { await fileStore.FlushAsync(persistentStorage); }
                catch (Exception exception) { Console.Error.WriteLine("File commit failed during shutdown: " + exception); }
            }
            await fileStore.DisposeAsync();
        }

        if (module is not null)
        {
            await module.InvokeVoidAsync("stopBrowserHost");
            await module.DisposeAsync();
        }

        self?.Dispose();
        osu.Framework.Audio.Track.BrowserTrackProvider.CreateTrack = null;
        osu.Framework.Audio.Sample.BrowserSampleFactory.CreateFactory = null;
        if (samplesModule is not null)
        {
            samplesModule.InvokeVoid("disposeSamples");
            await samplesModule.DisposeAsync();
        }
        if (audioModule is not null)
        {
            audioModule.InvokeVoid("disposeAudio");
            await audioModule.DisposeAsync();
        }
    }
