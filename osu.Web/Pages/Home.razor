@page "/"
@using osu.Game

<PageTitle>osu! web port laboratory</PageTitle>

<main class="status">
    <div class="ring" aria-hidden="true"><span>web</span></div>
    <p class="phase">BROWSER PORT · PHASE 1</p>
    <h1>osu!lazer game code is loaded.</h1>
    <p>The browser is now running a build that directly references the original osu.Game project. The next milestone is replacing the native host with a canvas-backed browser host.</p>
    <dl>
        <div><dt>.NET runtime</dt><dd>browser-wasm</dd></div>
        <div><dt>Game assembly</dt><dd>@typeof(OsuGame).Assembly.GetName().Name</dd></div>
        <div><dt>Renderer</dt><dd>WebGL adapter next</dd></div>
        <div><dt>Audio</dt><dd>Web Audio adapter pending</dd></div>
    </dl>
</main>
