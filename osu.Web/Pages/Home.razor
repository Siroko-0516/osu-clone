@page "/"
@using osu.Game
@using osu.Game.Rulesets.Osu
@using osu.Game.Rulesets.Mania
@using osu.Game.Rulesets.Taiko
@using osu.Game.Rulesets.Catch
@using osu.Framework.Platform
@using osu.Game.Rulesets.Osu.Configuration
@using osu.Web.Storage
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject osu.Game.Database.Persistence.IRecordStore Records

<PageTitle>osu! · Browser player</PageTitle>

<main class="app-shell">
    <header class="app-header">
        <a class="brand" href="" aria-label="osu browser home"><span class="brand-disc">osu!</span><span>browser player<small>LOCAL MUSIC · FOUR RULESETS</small></span></a>
        <nav class="header-actions" aria-label="Main navigation">
            <button class="@(showSettings ? "" : "active")" @onclick="OpenLibrary" disabled="@Busy">Songs</button>
            <button class="@(showSettings ? "active" : "")" @onclick="ToggleSettings" disabled="@Busy">Settings</button>
            <button @onclick="SwitchRuntime">@(Diagnostics ? "Player" : "Diagnostics")</button>
        </nav>
    </header>

    @if (gameFailed)
    {
        <div class="notice error" role="alert"><strong>The player stopped.</strong> @gameStatus <button @onclick="ReloadRuntime">Reload player</button></div>
    }

    @if (showSettings)
    {
        <section class="settings-panel">
            <p class="eyebrow">MAKE IT YOURS</p><h1>Controls & settings</h1>
            <nav class="mode-picker" aria-label="Ruleset">
                @foreach (var mode in new[] { "osu", "mania", "taiko", "catch" })
                {
                    <button class="@(selectedMode == mode ? "active" : null)" disabled="@Busy" @onclick="() => SelectMode(mode)">@mode</button>
                }
            </nav>
            @if (selectedMode == "mania")
            {
                <nav class="key-picker" aria-label="osu!mania key count">
                    @for (int keys = 1; keys <= 9; keys++)
                    {
                        int keyCount = keys;
                        <button class="@(maniaKeys == keyCount ? "active" : null)" disabled="@Busy" @onclick="() => SelectManiaKeys(keyCount)">@keyCount K</button>
                    }
                </nav>
            }
            <section class="binding-editor" aria-label="Current ruleset key bindings">
                <div class="binding-title"><strong>@BindingEditorTitle</strong><button @onclick="ResetCurrentBindings" disabled="@bindingsSaving">Restore defaults</button></div>
                @foreach (var row in bindingRows)
                {
                    <label @key="row"><span>@row.ActionName</span><select value="@((int)row.Key)" @onchange="args => ChangeBinding(row, args)" disabled="@bindingsSaving">
                        @foreach (var key in selectableKeys) { <option value="@((int)key)">@key</option> }
                    </select></label>
                }
            </section>
            <p class="muted" role="status">@keyBindingStatus</p>
            <label class="setting-row"><input type="checkbox" disabled="@(osuConfig is null || settingsSaving)" checked="@(osuConfig?.Get<bool>(OsuRulesetSetting.SnakingInSliders) ?? true)" @onchange="SetSnaking" /> Snaking-in sliders <span>@settingsStatus</span></label>
        </section>
    }

    <section class="play-section" hidden="@(!showPlayfield && !Diagnostics)">
        <div class="play-heading"><div><p class="eyebrow">@BindingEditorTitle</p><h2>@(selectedBeatmap?.Metadata.Title ?? "Renderer diagnostics")</h2><span class="muted">@selectedDifficulty?.DifficultyName</span></div>
            <div class="button-row"><button @onclick="TogglePause" disabled="@(game?.GameplaySession is null || gameplayResult is not null)">@(gameplayPaused ? "Resume" : "Pause") · Esc</button><button @onclick="Fullscreen">Fullscreen</button><button @onclick="ReturnToLibrary" disabled="@Busy">Exit</button></div>
        </div>
        <section class="canvas-panel">
            <canvas @ref="canvas" tabindex="0" aria-label="osu browser game canvas"></canvas>
            <osu.Web.Components.GameplayHud Session="@(game?.GameplaySession)" />
            @if (audioNeedsGesture && gameplayResult is null)
            {
                <div class="pause-overlay"><h2>Tap to start audio</h2><p>Your browser needs a tap before playing this song.</p><button class="primary" @onclick="UnlockGameplayAudio">Start audio</button></div>
            }
            else if (gameplayPaused && gameplayResult is null)
            {
                <div class="pause-overlay"><p class="eyebrow">TAKE A BREATH</p><h2>Paused</h2><button class="primary" @onclick="TogglePause">Resume play</button><button @onclick="RestartGameplay" disabled="@Busy">Restart</button><button @onclick="ReturnToLibrary" disabled="@Busy">Back to songs</button></div>
            }
            <div class="canvas-hint">@ModeInputHint</div>
        </section>
        @if (game?.GameplaySession is not null && bindingRows.Count > 0)
        {
            <div class="touch-controls" aria-label="@BindingEditorTitle touch controls">
                @foreach (var row in bindingRows)
                {
                    string? code = ToBrowserCode(row.Key);
                    if (code is not null)
                    {
                        <button @key="row" class="touch-key" disabled="@(gameplayPaused || gameplayResult is not null)"
                            @onpointerdown="() => SetVirtualKey(code, true)" @onpointerdown:preventDefault
                            @onpointerup="() => SetVirtualKey(code, false)" @onpointerup:preventDefault
                            @onpointercancel="() => SetVirtualKey(code, false)" @onpointerleave="() => SetVirtualKey(code, false)">
                            <strong>@row.ActionName</strong><span>@row.Key</span>
                        </button>
                    }
                }
            </div>
        }
    </section>

    @if (gameplayResult is not null)
    {
        <section class="gameplay-result" aria-label="Play results" role="status">
            <p class="eyebrow">PLAY COMPLETE</p><h1>@gameplayResult.Difficulty</h1>
            <div class="result-grid"><div><small>SCORE</small><strong>@gameplayResult.Score.ToString("N0")</strong></div><div><small>ACCURACY</small><strong>@gameplayResult.Accuracy.ToString("P2")</strong></div><div><small>MAX COMBO</small><strong>@(gameplayResult.Combo)×</strong></div></div>
            <p class="muted">@scoreSaveStatus</p>
            <div class="button-row"><button class="primary" @onclick="RestartGameplay" disabled="@Busy">Play again</button><button @onclick="ReturnToLibrary" disabled="@Busy">Back to songs</button></div>
        </section>
    }

    @if (!showPlayfield && !showSettings)
    {
        <section class="library-intro"><div><p class="eyebrow">YOUR MUSIC. YOUR RHYTHM.</p><h1>Choose your next beat.</h1><p class="muted">Import an .osz beatmap, pick a difficulty, and play.</p></div>
            <label class="import-button">＋ Import beatmap<InputFile OnChange="ImportBeatmap" accept=".osz,application/zip" disabled="@(Busy || game is null || gameFailed)" /></label>
        </section>
        <p class="import-status" role="status">@beatmapImportStatus</p>
        <section class="song-library" aria-label="Imported songs">
            <div class="library-toolbar"><label class="search-field"><span>Search</span><input @bind="SongSearch" @bind:event="oninput" placeholder="Title, artist or mapper" /></label><span class="muted">@(beatmapCatalog?.Sets.Count ?? 0) songs · @savedScores.Count scores</span></div>
            @if (beatmapCatalog is null || beatmapLoader is null)
            {
                <div class="empty-state"><h2>Getting the player ready…</h2><p>Loading your local library and controls.</p></div>
            }
            else if (beatmapCatalog.Sets.Count == 0)
            {
                <div class="empty-state"><span class="empty-disc">♪</span><h2>Your library starts here.</h2><p>Choose an .osz file above. Songs and completed scores stay in this browser.</p><span class="mode-tags">osu!standard · mania · taiko · catch</span></div>
            }
            else
            {
                @foreach (var set in VisibleSets)
                {
                    <article class="song-card" @key="set.Id"><div class="song-art" aria-hidden="true">♪</div><div class="song-content"><p class="eyebrow">@set.Artist</p><h2>@set.Title</h2><p class="muted">Mapped by @set.Creator</p>
                        <div class="difficulty-list">
                            @foreach (var difficulty in beatmapCatalog.GetBeatmaps(set.Id))
                            {
                                <div class="difficulty-actions" @key="difficulty.Id"><button disabled="@(Busy || game is null || gameFailed)" @onclick="() => SelectDifficulty(difficulty)"><span>@difficulty.DifficultyName</span><small>@RulesetLabel(difficulty.RulesetId)</small></button><button class="preview-button" disabled="@(Busy || game is null || gameFailed)" @onclick="() => PreviewDifficulty(difficulty)" aria-label="@($"Preview {difficulty.DifficultyName}")">♪</button></div>
                            }
                        </div></div></article>
                }
                @if (!VisibleSets.Any()) { <div class="empty-state"><h2>No matching songs.</h2><p>Try a different title, artist or mapper.</p></div> }
                <div class="pagination"><button disabled="@(songPage == 0)" @onclick="() => songPage--">Previous</button><span>Page @(songPage + 1)</span><button disabled="@(!HasMoreSongs)" @onclick="() => songPage++">Next</button></div>
            }
            <p class="selection-status" role="status">@selectionStatus</p>
            @if (songPreview is not null && game?.GameplaySession is null)
            {
                <button @onclick="StopSongPreviewAsync" disabled="@Busy">Stop preview</button>
                @if (songPreview.LoadError.Length > 0) { <p role="alert">@songPreview.LoadError</p> }
            }
        </section>
        @if (savedScores.Count > 0)
        {
            <section class="recent-scores"><p class="eyebrow">RECENT PLAYS</p><h2>Your local scores</h2>
                @foreach (var score in savedScores.Take(5))
                {
                    <div class="score-row"><span>@ScoreTitle(score.BeatmapId)<small>@RulesetLabel(score.RulesetId) · @score.Date.ToLocalTime().ToString("g")</small></span><strong>@score.TotalScore.ToString("N0") <small>@score.Accuracy.ToString("P2")</small></strong></div>
                }
            </section>
        }
    }

    @if (Diagnostics)
    {
        <section class="diagnostics"><h2>Runtime diagnostics</h2><div class="button-row"><button @onclick="StartAudioTest">Play audio test</button><button @onclick="StartSampleTest">Play sample test</button></div><dl>
            <div><dt>Runtime</dt><dd>@gameStatus</dd></div><div><dt>Renderer</dt><dd>@rendererStatus</dd></div><div><dt>Frames</dt><dd>@gameFrameCount</dd></div><div><dt>Input</dt><dd>@inputStatus</dd></div><div><dt>Storage</dt><dd>@fileStatus</dd></div><div><dt>Catalogue</dt><dd>@beatmapCatalogStatus</dd></div>
        </dl></section>
    }
    <footer>Browser port · Original rulesets · Local play <span>@(game is null ? "Starting…" : "Player ready")</span></footer>
</main>

@code {
    [SupplyParameterFromQuery(Name = "diagnostics")]
    public bool Diagnostics { get; set; }

    private bool Original => !Diagnostics;
    private bool showSettings;
    private bool showPlayfield;
    private bool gameplayPaused;
    private bool focusRequested;
    private bool Busy => loadingDifficulty || importingBeatmap;
    private string scoreSaveStatus = "";
    private IReadOnlyList<osu.Game.Database.Persistence.ScoreSnapshot> savedScores = Array.Empty<osu.Game.Database.Persistence.ScoreSnapshot>();

    private bool audioNeedsGesture;
    private void UnlockGameplayAudio()
    {
        audioModule?.InvokeVoid("unlockAudio");
        audioNeedsGesture = false;
        focusRequested = true;
    }

    private void ReloadRuntime() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    private async Task OpenLibrary() { await ReturnToLibrary(); showSettings = false; }
    private async Task ToggleSettings() { await ReturnToLibrary(); showSettings = !showSettings; }
    private async Task Fullscreen()
    {
        if (module is not null) await module.InvokeVoidAsync("toggleFullscreen");
    }
    private async Task TogglePause()
    {
        if (game?.GameplaySession is null || gameplayResult is not null || Busy) return;
        gameplayPaused = !gameplayPaused;
        if (gameplayPaused)
        {
            songPreview?.Stop();
            game.PauseGameplay();
        }
        else
        {
            audioModule?.InvokeVoid("unlockAudio");
            game.ResumeGameplay();
            focusRequested = true;
        }
        if (module is not null) await module.InvokeVoidAsync("setGameplayActive", !gameplayPaused);
    }
    [JSInvokable]
    public async Task PauseFromBrowser(bool toggle)
    {
        if (game?.GameplaySession is null || gameplayResult is not null || Busy) return;
        if (toggle || !gameplayPaused) await TogglePause();
        await InvokeAsync(StateHasChanged);
    }
    private string ScoreTitle(string id)
    {
        var difficulty = beatmapCatalog?.Beatmaps.FirstOrDefault(item => item.Id == id);
        var set = beatmapCatalog?.Sets.FirstOrDefault(item => item.Id == difficulty?.SetId);
        return set is null ? "Imported difficulty" : $"{set.Title} · {difficulty?.DifficultyName}";
    }
    private async Task SaveCompletedScore(PlayResult result)
    {
        if (persistence is null || selectedDifficulty is null) return;
        var score = new osu.Game.Database.Persistence.ScoreSnapshot(Guid.NewGuid().ToString("N"),
            selectedDifficulty.Id, selectedDifficulty.RulesetId, result.Score, result.Accuracy,
            DateTimeOffset.UtcNow, "Local player");
        try
        {
            await persistence.Scores.SaveAsync(score.Id, score);
            savedScores = persistence.Scores.Values.OrderByDescending(item => item.Date).ToArray();
            scoreSaveStatus = "Saved to this browser.";
        }
        catch (Exception exception) { scoreSaveStatus = "Score could not be saved: " + exception.Message; }
    }

    private void SwitchRuntime() => Navigation.NavigateTo(Original ? "?diagnostics=true" : "", forceLoad: true);

    private ElementReference canvas;
    private IJSObjectReference? module;
    private IJSInProcessObjectReference? audioModule;
    private IJSInProcessObjectReference? samplesModule;
    private DotNetObjectReference<Home>? self;
    private WebGameHost? gameHost;
    private BrowserBootstrapGame? game;
    private long gameFrameCount;
    private int lastFrameFloatCount;
    private string rendererStatus = "initialising";
    private string gameStatus = "waiting";
    private string inputStatus = "waiting";
    private string selectedMode = "osu";
    private int maniaKeys = 4;
    private string ModeInputHint => selectedMode switch
    {
        "osu" => "osu!standard · aim with the pointer · hit/hold with mouse or Z / X",
        "mania" => $"osu!mania {maniaKeys}K · play all {maniaKeys} note lanes with keyboard keys",
        "taiko" => "osu!taiko · hit rim/centre with D / F / J / K",
        "catch" => "osu!catch · move with Z / X or ← / → · dash with Shift",
        _ => "Keyboard input"
    };
    private bool gameFailed;
    private int consecutiveFrameFailures;
    private BrowserSettingsStore? settingsStore;
    private BrowserKeyBindingStore? keyBindingStore;
    private string keyBindingStatus = "Loading";
    private OsuRulesetConfigManager? osuConfig;
    private readonly List<IDisposable> rulesetConfigs = new();
    private bool settingsSaving;
    private string settingsStatus = "Loading browser settings";
    private BrowserFileStore? fileStore;
    private osu.Framework.Platform.Storage? persistentStorage;
    private string fileStatus = "Loading browser files";
    private osu.Game.Database.Persistence.IGamePersistence? persistence;
    private osu.Game.Database.Persistence.BeatmapCatalogStore? beatmapCatalog;
    private string beatmapCatalogStatus = "Loading browser beatmap metadata";
    private string beatmapImportStatus = "No beatmap imported";
    private bool importingBeatmap;
    private BrowserBeatmapLoader? beatmapLoader;
    private osu.Game.Database.Persistence.BeatmapSnapshot? selectedDifficulty;
    private osu.Game.Beatmaps.IBeatmap? selectedBeatmap;
    private WebAudioTrack? songPreview;
    private bool loadingDifficulty;
    private PlayResult? gameplayResult;
    private sealed record PlayResult(string Difficulty, long Score, double Accuracy, int Combo);
    private readonly HashSet<string> hydratedPaths = new(StringComparer.Ordinal);

    private void ReleaseHydratedFiles()
    {
        if (persistentStorage is null) return;
        foreach (string path in hydratedPaths) persistentStorage.Delete(path);
        hydratedPaths.Clear();
    }

    private Task RestartGameplay() => selectedDifficulty is { } difficulty
        ? SelectDifficulty(difficulty) : Task.CompletedTask;

    private async Task ReturnToLibrary()
    {
        await StopSongPreviewAsync();
        if (module is not null) await module.InvokeVoidAsync("exitFullscreen");
        selectedBeatmap = null;
        selectedDifficulty = null;
        gameplayResult = null;
        showPlayfield = false;
        gameplayPaused = false;
        if (module is not null) await module.InvokeVoidAsync("setGameplayActive", Diagnostics);
        selectionStatus = "Select a difficulty to play.";
    }
    private string songSearch = "";
    private int songPage;
    private string SongSearch { get => songSearch; set { songSearch = value; songPage = 0; } }
    private bool HasMoreSongs => FilteredSets.Skip((songPage + 1) * 20).Any();
    private IEnumerable<osu.Game.Database.Persistence.BeatmapSetSnapshot> VisibleSets => FilteredSets.Skip(songPage * 20).Take(20);
    private string selectionStatus = "Select a difficulty to load it.";
    private IEnumerable<osu.Game.Database.Persistence.BeatmapSetSnapshot> FilteredSets =>
        (beatmapCatalog?.Sets ?? Array.Empty<osu.Game.Database.Persistence.BeatmapSetSnapshot>())
        .Where(set => string.IsNullOrWhiteSpace(songSearch) || $"{set.Artist} {set.Title} {set.Creator}".Contains(songSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string RulesetLabel(int mode) => mode switch
    {
        0 => "osu!standard", 1 => "osu!taiko", 2 => "osu!catch", 3 => "osu!mania", _ => "Unknown mode"
    };

    private async Task SelectDifficulty(osu.Game.Database.Persistence.BeatmapSnapshot difficulty)
    {
        if (loadingDifficulty || importingBeatmap)
            return;

        loadingDifficulty = true;
        try
        {
            if (beatmapLoader is null || persistentStorage is null || audioModule is null || fileStore is null || beatmapCatalog is null || game is null)
                return;

            // Resume the browser audio context while this method still runs as a
            // direct user gesture. File hydration below may otherwise lose it.
            audioModule.InvokeVoid("unlockAudio");
            await StopSongPreviewAsync();
            selectedDifficulty = null;
            selectedBeatmap = null;
            gameplayResult = null;

            var set = beatmapCatalog.Sets.Single(candidate => candidate.Id == difficulty.SetId);
            selectionStatus = $"Loading {difficulty.DifficultyName}…";
            await InvokeAsync(StateHasChanged);

            // Loading an entire set can exceed the mobile WebAssembly heap. The
            // decoder and gameplay clock only require the selected .osu and audio.
            hydratedPaths.Add(difficulty.BeatmapPath);
            hydratedPaths.Add(difficulty.AudioPath);
            int loadedFiles = await fileStore.HydratePathsAsync(
                persistentStorage,
                new[] { difficulty.BeatmapPath, difficulty.AudioPath });
            fileStatus = $"{loadedFiles} files loaded for {set.Title}";

            selectionStatus = "Decoding difficulty…";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1);
            var loaded = beatmapLoader.Load(difficulty.Id);
            string mode = difficulty.RulesetId switch { 0 => "osu", 1 => "taiko", 2 => "catch", 3 => "mania", _ => throw new InvalidDataException("Unsupported mode.") };
            if (mode == "mania") maniaKeys = (int)loaded.Difficulty.CircleSize;
            await SelectMode(mode);

            var nextTrack = game.CreateBrowserTrack(audioModule, persistentStorage.GetStream(difficulty.AudioPath), difficulty.AudioPath);
            showSettings = false;
            showPlayfield = true;
            gameplayPaused = false;
            focusRequested = true;
            await InvokeAsync(StateHasChanged);
            try { await game.LoadBeatmapAsync(loaded, CurrentRuleset, nextTrack); }
            catch { nextTrack.Dispose(); throw; }
            songPreview = nextTrack;
            selectedDifficulty = difficulty;
            selectedBeatmap = loaded;
            selectionStatus = $"Starting {difficulty.DifficultyName}: {loaded.HitObjects.Count} objects using the original {RulesetLabel(difficulty.RulesetId)} playfield…";
        }
        catch (Exception exception)
        {
            showPlayfield = false;
            selectionStatus = "Could not load difficulty: " + exception.Message;
        }
        finally
        {
            // Decoder and WebAudioTrack have consumed their streams. Keep the durable
            // IndexedDB copy, but release WASM virtual-filesystem copies immediately.
            ReleaseHydratedFiles();
            loadingDifficulty = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PreviewDifficulty(osu.Game.Database.Persistence.BeatmapSnapshot difficulty)
    {
        if (Busy || gameFailed || persistentStorage is null || audioModule is null
            || fileStore is null || game is null || beatmapLoader is null) return;
        loadingDifficulty = true;
        try
        {
            audioModule.InvokeVoid("unlockAudio");
            await StopSongPreviewAsync();
            hydratedPaths.Add(difficulty.BeatmapPath);
            hydratedPaths.Add(difficulty.AudioPath);
            await fileStore.HydratePathsAsync(persistentStorage, hydratedPaths);
            var beatmap = beatmapLoader.Load(difficulty.Id);
            songPreview = game.CreateBrowserTrack(audioModule, persistentStorage.GetStream(difficulty.AudioPath), difficulty.AudioPath);
            songPreview.Seek(Math.Max(0, beatmap.Metadata.PreviewTime));
            songPreview.Start();
            selectionStatus = $"Previewing {beatmap.Metadata.Title}. Select a difficulty to play.";
        }
        catch (Exception exception) { await StopSongPreviewAsync(); selectionStatus = "Preview failed: " + exception.Message; }
        finally { ReleaseHydratedFiles(); loadingDifficulty = false; }
    }

    private async Task StopSongPreviewAsync()
    {
        WebAudioTrack? previousTrack = songPreview;
        songPreview = null;
        audioNeedsGesture = false;
        bool ownedBySession = previousTrack is not null && game?.GameplaySession?.Track == previousTrack;
        if (game?.GameplaySession is not null && !gameFailed)
            await game.StopGameplayAsync();
        if (previousTrack is not null && !ownedBySession)
        {
            previousTrack.Stop();
            previousTrack.Dispose();
        }
        ReleaseHydratedFiles();
    }

    private bool bindingsSaving;
    private List<BindingEditorRow> bindingRows = new();
    private static readonly osu.Framework.Input.Bindings.InputKey[] selectableKeys = Enum.GetValues<osu.Framework.Input.Bindings.InputKey>()
        .Where(key => ((int)key >= 1 && (int)key <= 130) || ((int)key >= 132 && (int)key <= 134))
        .DistinctBy(key => (int)key).ToArray();
    private int CurrentVariant => selectedMode == "mania" ? maniaKeys : 0;
    private osu.Game.Rulesets.Ruleset CurrentRuleset => selectedMode switch
    {
        "mania" => new ManiaRuleset(), "taiko" => new TaikoRuleset(), "catch" => new CatchRuleset(), _ => new OsuRuleset()
    };
    private string BindingEditorTitle => selectedMode switch
    {
        "osu" => "osu!standard", "mania" => $"osu!mania {maniaKeys}K", "taiko" => "osu!taiko", "catch" => "osu!catch", _ => selectedMode
    };

    private string GetActionName(int action) => selectedMode switch
    {
        "mania" => Enum.GetName(typeof(ManiaAction), action),
        "taiko" => Enum.GetName(typeof(TaikoAction), action),
        "catch" => Enum.GetName(typeof(CatchAction), action),
        _ => Enum.GetName(typeof(OsuAction), action)
    } ?? action.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private sealed class BindingEditorRow
    {
        public required int Action { get; init; }
        public required string ActionName { get; init; }
        public osu.Framework.Input.Bindings.InputKey Key { get; set; }
    }

    private void LoadBindingEditor()
    {
        if (keyBindingStore is null) return;
        var ruleset = CurrentRuleset;
        IReadOnlyList<osu.Framework.Input.Bindings.IKeyBinding> bindings = keyBindingStore.GetBindings(ruleset.RulesetInfo.ShortName, CurrentVariant);
        if (bindings.Count == 0) bindings = ruleset.GetDefaultKeyBindings(CurrentVariant).Cast<osu.Framework.Input.Bindings.IKeyBinding>().ToArray();
        bindingRows = bindings.Where(binding => binding.KeyCombination.Keys.Any(key => key != osu.Framework.Input.Bindings.InputKey.None))
            .Select(binding => new BindingEditorRow
            {
                Action = Convert.ToInt32(binding.Action),
                ActionName = GetActionName(Convert.ToInt32(binding.Action)),
                Key = binding.KeyCombination.Keys.First(key => key != osu.Framework.Input.Bindings.InputKey.None)
            }).ToList();
    }

    private async Task SaveBindingEditor()
    {
        if (keyBindingStore is null) return;
        bindingsSaving = true;
        try
        {
            var ruleset = CurrentRuleset;
            await keyBindingStore.SaveBindingsAsync(ruleset.RulesetInfo.ShortName, CurrentVariant,
                bindingRows.Select(row => (osu.Framework.Input.Bindings.IKeyBinding)new osu.Framework.Input.Bindings.KeyBinding(row.Key, row.Action)));
            await SyncBrowserBindings();
            keyBindingStatus = $"{BindingEditorTitle} bindings saved and active";
        }
        catch (Exception exception) { keyBindingStatus = "Save failed: " + exception.Message; }
        finally { bindingsSaving = false; }
    }

    private async Task ChangeBinding(BindingEditorRow row, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int value) && Enum.IsDefined(typeof(osu.Framework.Input.Bindings.InputKey), value))
        {
            var next = (osu.Framework.Input.Bindings.InputKey)value;
            if (bindingRows.Any(other => !ReferenceEquals(other, row) && other.Key == next))
            {
                keyBindingStatus = $"{next} is already assigned in {BindingEditorTitle}";
                LoadBindingEditor();
                await InvokeAsync(StateHasChanged);
                return;
            }
            row.Key = next;
            await SaveBindingEditor();
        }
    }

    private async Task ResetCurrentBindings()
    {
        if (keyBindingStore is null) return;
        var ruleset = CurrentRuleset;
        await keyBindingStore.SaveBindingsAsync(ruleset.RulesetInfo.ShortName, CurrentVariant, ruleset.GetDefaultKeyBindings(CurrentVariant));
        LoadBindingEditor();
        await SyncBrowserBindings();
        keyBindingStatus = $"{BindingEditorTitle} defaults restored";
    }

    private async Task SetActionKeys(bool useA)
    {
        if (keyBindingStore is null) return;
        try
        {
            var ruleset = new OsuRuleset();
            var bindings = ruleset.GetDefaultKeyBindings(0).Select(binding => (osu.Framework.Input.Bindings.IKeyBinding)new osu.Framework.Input.Bindings.KeyBinding(
                new osu.Framework.Input.Bindings.KeyCombination(binding.KeyCombination.Keys.Select(key => useA && key == osu.Framework.Input.Bindings.InputKey.Z ? osu.Framework.Input.Bindings.InputKey.A : key).ToArray()), binding.Action));
            await keyBindingStore.SaveBindingsAsync(ruleset.RulesetInfo.ShortName, 0, bindings);
            LoadBindingEditor();
            await SyncBrowserBindings();
            keyBindingStatus = useA ? "A / X saved" : "Z / X defaults saved";
        }
        catch (Exception exception) { keyBindingStatus = "Save failed: " + exception.Message; }
    }

    private async Task SetSnaking(ChangeEventArgs args)
    {
        if (osuConfig is null || settingsStore is null) return;
        settingsSaving = true;
        settingsStatus = "Saving";
        try
        {
            osuConfig.SetValue(OsuRulesetSetting.SnakingInSliders, args.Value is true);
            osuConfig.Save();
            await settingsStore.FlushAsync();
            settingsStatus = "Saved to browser";
        }
        catch (Exception exception) { settingsStatus = "Save failed: " + exception.Message; }
        finally { settingsSaving = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (focusRequested && module is not null)
            {
                focusRequested = false;
                await module.InvokeVoidAsync("focusPlayfield");
                await module.InvokeVoidAsync("setGameplayActive", true);
            }
            return;
        }

        try
        {
            settingsStore = await BrowserSettingsStore.CreateAsync(Records);
            keyBindingStore = await BrowserKeyBindingStore.CreateAsync(Records);
            persistence = await osu.Game.Database.Persistence.GamePersistence.CreateAsync(Records, settingsStore);
            beatmapCatalog = persistence.Beatmaps;
            savedScores = persistence.Scores.Values.OrderByDescending(item => item.Date).ToArray();
            beatmapCatalogStatus = $"{beatmapCatalog.Sets.Count} sets / {beatmapCatalog.Beatmaps.Count} difficulties restored";
            keyBindingStatus = "Browser key bindings loaded";
            LoadBindingEditor();
            foreach (var ruleset in new osu.Game.Rulesets.Ruleset[] { new OsuRuleset(), new ManiaRuleset(), new TaikoRuleset(), new CatchRuleset() })
            {
                var config = ruleset.CreateConfig(settingsStore);
                if (config is not null) rulesetConfigs.Add(config);
                if (config is OsuRulesetConfigManager standardConfig) osuConfig = standardConfig;
            }
            await settingsStore.FlushAsync();
            settingsStatus = "All four original ruleset settings loaded";
            audioModule = (IJSInProcessObjectReference)await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserAudio.mjs");
            osu.Framework.Audio.Track.BrowserTrackProvider.CreateTrack = (stream, name) => new WebAudioTrack(audioModule, stream, name);
            samplesModule = (IJSInProcessObjectReference)await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserSamples.mjs");
            osu.Framework.Audio.Sample.BrowserSampleFactory.CreateFactory = (bytes, name, mixer) => new WebAudioSampleFactory(samplesModule, bytes, name, mixer);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/browserHost.js?v=16-render-recovery");
            self = DotNetObjectReference.Create(this);
            bool rendererReady = await module.InvokeAsync<bool>("startBrowserHost", canvas, self);
            if (!rendererReady)
            {
                gameFailed = true;
                gameStatus = "Stopped — WebGL2 unavailable";
                StateHasChanged();
                return;
            }

            await module.InvokeVoidAsync("setGameplayActive", Diagnostics);
            gameStatus = "initialising BrowserGameHost";
            StateHasChanged();
            gameHost = new WebGameHost("osu-web");
            gameHost.ExceptionThrown += exception =>
            {
                // Framework thread failures otherwise remain in an internal log
                // while the browser keeps presenting the last captured frame.
                gameFailed = true;
                gameStatus = FormatException(exception);
                songPreview?.Stop();
                return true;
            };
            persistentStorage = gameHost.GetStorage("/osu-data");
            fileStore = new BrowserFileStore(JS);
            int storedFiles = await fileStore.CountAsync();
            fileStatus = $"{storedFiles} browser files available on demand";
            beatmapLoader = new BrowserBeatmapLoader(beatmapCatalog, path => persistentStorage.GetStream(path, FileAccess.Read, FileMode.Open));
            osu.Framework.Game selectedGame;
            if (Original)
                selectedGame = game = new BrowserOsuGame(keyBindingStore, persistence);
            else
                selectedGame = game = new BrowserBootstrapGame(keyBindingStore, persistence);
            // Framework threads install their own SynchronizationContext. Blazor must
            // regain its context before awaiting JS interop or dispatching UI work.
            var browserContext = System.Threading.SynchronizationContext.Current;
            try
            {
                gameHost.Run(selectedGame);
            }
            finally
            {
                System.Threading.SynchronizationContext.SetSynchronizationContext(browserContext);
            }
            gameStatus = Original ? "Realm-free browser game running" : "Framework diagnostic running — not OsuGame";
        }
        catch (Exception exception)
        {
            gameFailed = true;
            gameStatus = FormatException(exception);
        }

        StateHasChanged();
    }

    private async Task SelectMode(string mode)
    {
        if (game?.GameplaySession is not null || songPreview is not null || selectedDifficulty is not null)
            await ReturnToLibrary();
        selectedMode = mode;
        game?.SetRuleset(mode, mode == "mania" ? maniaKeys : 0);
        LoadBindingEditor();
        keyBindingStatus = $"{BindingEditorTitle} bindings loaded";
        await SyncBrowserBindings();
    }

    private async Task SelectManiaKeys(int keys)
    {
        if (loadingDifficulty || importingBeatmap) return;
        await ReturnToLibrary();
        maniaKeys = Math.Clamp(keys, 1, 9);
        game?.SetRuleset("mania", maniaKeys);
        LoadBindingEditor();
        await SyncBrowserBindings();
        keyBindingStatus = $"mania {maniaKeys}K bindings loaded";
        await InvokeAsync(StateHasChanged);
    }

    private ValueTask SetVirtualKey(string code, bool pressed)
    {
        return module is null
            ? ValueTask.CompletedTask
            : module.InvokeVoidAsync("setVirtualKey", code, pressed);
    }

    private async Task SyncBrowserBindings()
    {
        if (module is null)
            return;

        string[] codes = bindingRows.Select(row => ToBrowserCode(row.Key))
                                    .Where(code => code is not null)
                                    .Cast<string>()
                                    .Distinct(StringComparer.Ordinal)
                                    .ToArray();
        await module.InvokeVoidAsync("setRuleset", selectedMode, (object)codes);
    }

    private static string? ToBrowserCode(osu.Framework.Input.Bindings.InputKey key)
    {
        string name = key.ToString();
        if (name.Length == 1 && name[0] is >= 'A' and <= 'Z')
            return "Key" + name;
        if (name.StartsWith("Number", StringComparison.Ordinal) && name.Length == 7)
            return "Digit" + name[6];
        if (name.StartsWith("Keypad", StringComparison.Ordinal))
            return "Numpad" + name[6..];

        return key switch
        {
            osu.Framework.Input.Bindings.InputKey.Left => "ArrowLeft",
            osu.Framework.Input.Bindings.InputKey.Right => "ArrowRight",
            osu.Framework.Input.Bindings.InputKey.Up => "ArrowUp",
            osu.Framework.Input.Bindings.InputKey.Down => "ArrowDown",
            osu.Framework.Input.Bindings.InputKey.Shift => "ShiftLeft",
            osu.Framework.Input.Bindings.InputKey.Control => "ControlLeft",
            osu.Framework.Input.Bindings.InputKey.Alt => "AltLeft",
            osu.Framework.Input.Bindings.InputKey.BackSpace => "Backspace",
            osu.Framework.Input.Bindings.InputKey.Tilde => "Backquote",
            osu.Framework.Input.Bindings.InputKey.Plus => "Equal",
            osu.Framework.Input.Bindings.InputKey.BackSlash => "Backslash",
            >= osu.Framework.Input.Bindings.InputKey.MouseLeft => null,
            _ => name,
        };
    }

    private async Task StartAudioTest()
    {
        if (loadingDifficulty || importingBeatmap) return;
        await ReturnToLibrary();
        audioModule?.InvokeVoid("unlockAudio");
        game?.StartAudioTest();
        await FlushFiles();
    }

    private async Task ImportBeatmap(InputFileChangeEventArgs args)
    {
        if (beatmapCatalog is null || persistentStorage is null || fileStore is null)
            return;

        if (loadingDifficulty || importingBeatmap) return;
        importingBeatmap = true;
        beatmapImportStatus = $"Reading {args.File.Name}";
        try
        {
            await StopSongPreviewAsync();
            selectedDifficulty = null;
            selectedBeatmap = null;
            selectionStatus = "Select a difficulty to load it.";
            gameplayResult = null;

            osu.Game.Database.Persistence.OszImportPackage package;
            int savedFiles = 0;
            await using (Stream stream = args.File.OpenReadStream(maxAllowedSize: 256 * 1024 * 1024))
            {
                // InputFile is forward-only. Keep only the compressed archive in memory;
                // each decompressed entry is persisted and released independently.
                using var archiveBytes = new MemoryStream(checked((int)args.File.Size));
                await stream.CopyToAsync(archiveBytes);
                archiveBytes.Position = 0;
                package = await osu.Game.Database.Persistence.OszArchiveReader.ReadStreamingAsync(
                    archiveBytes,
                    async file =>
                    {
                        await fileStore.PutAsync(new[]
                        {
                            new BrowserFileStore.Entry
                            {
                                Path = file.Path,
                                Data = file.Data,
                            },
                        });

                        savedFiles++;
                        if (savedFiles % 16 == 0)
                        {
                            beatmapImportStatus = $"Saving {savedFiles} files";
                            await InvokeAsync(StateHasChanged);
                        }
                    });
            }

            await beatmapCatalog.SaveSetAsync(package.Set, package.Beatmaps);
            beatmapCatalogStatus = $"{beatmapCatalog.Sets.Count} sets / {beatmapCatalog.Beatmaps.Count} difficulties restored";
            beatmapImportStatus = $"Imported {package.Set.Artist} — {package.Set.Title} ({package.Beatmaps.Count} difficulties)";
        }
        catch (OutOfMemoryException)
        {
            beatmapImportStatus = "Import failed: this .osz is too large for the current browser memory limit.";
        }
        catch (Exception exception)
        {
            beatmapImportStatus = "Import failed: " + exception.Message;
        }
        finally
        {
            importingBeatmap = false;
        }
    }

    private async Task StartSampleTest()
    {
        audioModule?.InvokeVoid("unlockAudio");
        game?.StartSampleTest();
        await FlushFiles();
    }

    private Task FlushFiles()
    {
        // Beatmap assets are committed individually during import. Replacing the
        // whole IndexedDB snapshot here would discard sets that are not hydrated.
        fileStatus = "Browser files saved incrementally";
        return InvokeAsync(StateHasChanged);
    }

