<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Framework dependency injection reads nullable metadata at runtime. -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Desktop-only transitive shim; BrowserGameHost never executes it and Mono cannot AOT it. -->
    <_AOT_InternalForceInterpretAssemblies Include="alsa-sharp.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="SDL2-CS.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="SDL3-CS.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="FFmpeg.AutoGen.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.Configurations.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.Native.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.Plugin.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.Fx.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.Mix.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.Wasapi.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.MetalBindings.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.OpenGLBindings.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.SPIRV.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.D3DCompiler.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.Direct3D11.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.Direct3D12.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.DirectX.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.DXGI.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.Mathematics.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Realm.dll" />
  </ItemGroup>
  <!-- Desktop model/native binding assemblies remain available for metadata, but
       BrowserGameHost never executes their native callbacks. Keep them bundled
       for type resolution while excluding them from the callback scanner, then
       restore them as interpreted assemblies before AOT. -->
  <Target Name="ExcludeDesktopBindingsFromBrowserNativeScan" BeforeTargets="_GenerateManagedToNative" Condition="'$(BrowserPublish)' == 'true'">
    <ItemGroup>
      <_BrowserNativeBindingAssemblies Include="@(_WasmAssembliesInternal)" Condition="'%(_WasmAssembliesInternal.FileName)' == 'Realm' Or '%(_WasmAssembliesInternal.FileName)' == 'alsa-sharp' Or '%(_WasmAssembliesInternal.FileName)' == 'SDL2-CS' Or '%(_WasmAssembliesInternal.FileName)' == 'SDL3-CS' Or '%(_WasmAssembliesInternal.FileName)' == 'FFmpeg.AutoGen' Or '%(_WasmAssembliesInternal.FileName)' == 'OpenTabletDriver' Or '%(_WasmAssembliesInternal.FileName)' == 'OpenTabletDriver.Configurations' Or '%(_WasmAssembliesInternal.FileName)' == 'OpenTabletDriver.Native' Or '%(_WasmAssembliesInternal.FileName)' == 'OpenTabletDriver.Plugin' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.ManagedBass' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.ManagedBass.Fx' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.ManagedBass.Mix' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.ManagedBass.Wasapi' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.Veldrid' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.Veldrid.MetalBindings' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.Veldrid.OpenGLBindings' Or '%(_WasmAssembliesInternal.FileName)' == 'ppy.Veldrid.SPIRV' Or '%(_WasmAssembliesInternal.FileName)' == 'Vortice.D3DCompiler' Or '%(_WasmAssembliesInternal.FileName)' == 'Vortice.Direct3D11' Or '%(_WasmAssembliesInternal.FileName)' == 'Vortice.Direct3D12' Or '%(_WasmAssembliesInternal.FileName)' == 'Vortice.DirectX' Or '%(_WasmAssembliesInternal.FileName)' == 'Vortice.DXGI' Or '%(_WasmAssembliesInternal.FileName)' == 'Vortice.Mathematics'" />
      <_WasmAssembliesInternal Remove="@(_BrowserNativeBindingAssemblies)" />
    </ItemGroup>
  </Target>
  <Target Name="RestoreDesktopBindingsAfterBrowserNativeScan" AfterTargets="_GenerateManagedToNative" BeforeTargets="_WasmAotCompileApp" Condition="'$(BrowserPublish)' == 'true'">
    <ItemGroup>
      <_WasmAssembliesInternal Include="@(_BrowserNativeBindingAssemblies)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.20" PrivateAssets="all" />
  </ItemGroup>
</Project>
