<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Framework dependency injection reads nullable metadata at runtime. -->
    <NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Desktop-only transitive shim; BrowserGameHost never executes it and Mono cannot AOT it. -->
    <_AOT_InternalForceInterpretAssemblies Include="alsa-sharp.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="SDL2-CS.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="SDL3-CS.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="FFmpeg.AutoGen.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.Configurations.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.Native.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="OpenTabletDriver.Plugin.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.Fx.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.Mix.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.ManagedBass.Wasapi.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.MetalBindings.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.OpenGLBindings.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="ppy.Veldrid.SPIRV.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.D3DCompiler.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.Direct3D11.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.Direct3D12.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.DirectX.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.DXGI.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Vortice.Mathematics.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Realm.dll" />
  </ItemGroup>
  <!-- Realm model base types are still needed as metadata by osu.Game, but the
       browser persistence path never calls Realm's native callbacks. Keep Realm
       bundled for type resolution while excluding it from the native callback
       scanner, then restore it as an interpreted assembly before AOT. -->
  <Target Name="ExcludeRealmFromBrowserNativeScan" BeforeTargets="_GenerateManagedToNative" Condition="'$(BrowserPublish)' == 'true'">
    <ItemGroup>
      <_BrowserRealmAssembly Include="@(_WasmAssembliesInternal)" Condition="'%(_WasmAssembliesInternal.FileName)' == 'Realm'" />
      <_WasmAssembliesInternal Remove="@(_BrowserRealmAssembly)" />
    </ItemGroup>
  </Target>
  <Target Name="RestoreRealmAfterBrowserNativeScan" AfterTargets="_GenerateManagedToNative" BeforeTargets="_WasmAotCompileApp" Condition="'$(BrowserPublish)' == 'true'">
    <ItemGroup>
      <_WasmAssembliesInternal Include="@(_BrowserRealmAssembly)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\osu.Game\osu.Game.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Osu\osu.Game.Rulesets.Osu.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Mania\osu.Game.Rulesets.Mania.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Taiko\osu.Game.Rulesets.Taiko.csproj" />
    <ProjectReference Include="..\osu.Game.Rulesets.Catch\osu.Game.Rulesets.Catch.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.20" PrivateAssets="all" />
  </ItemGroup>
</Project>
